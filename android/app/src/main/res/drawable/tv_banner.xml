<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp Android TV launcher banner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF0B1F3A" android:endColor="#FF0E9E90" android:angle="0" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp"
        android:drawable="@drawable/ic_stat_radio" />
</layer-list>
